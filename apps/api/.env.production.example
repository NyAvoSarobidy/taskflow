# ===========================================
# TaskFlow — Variables d'environnement PRODUCTION
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# Serveur
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.lcpacid.mongodb.net/taskflow?retryWrites=true&w=majority&appName=Cluster0

# JWT — Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<generer-un-secret-aleatoire-64-caracteres>
JWT_REFRESH_SECRET=<generer-un-autre-secret-aleatoire-64-caracteres>

JWT_ACCESS_SECRET=e2ba2aca266bc7a5ba54e09cb6b3d244bf856437c952dff6f1f256c1b536798eef7f6b095dc4c19505809f2fdd7c142f326f8581db10520fd34c00f81f8ce698
JWT_REFRESH_SECRET=5f2fc398a982abbda1fdd53b6cafc2efb6ce386ee0e142ed87e49c87cb71a5e4dfe171942c9f8fc7807bfc6617a3e61838d83b02a6288418e75f37a01d6d1f31
# Frontend URL (Vercel)
CLIENT_URL=https://ton-app.vercel.app

# Resend (email)
RESEND_API_KEY=re_xxxxx
# En production, vérifier un domaine sur resend.com/domains
# et utiliser: from: "TaskFlow <noreply@ton-domaine.com>"

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PRICE_ID_FREE=price_xxxxx
STRIPE_PRICE_ID_PRO=price_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
